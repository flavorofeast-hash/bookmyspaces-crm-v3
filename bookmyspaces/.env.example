# ═══════════════════════════════════════════════════════════
# BOOKMYSPACES AI CRM — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local (or any file with real secrets) to version control

# ─────────────────────────────────────────
# SUPABASE — REQUIRED (validated at startup, src/lib/env.ts)
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────
# AI — CLAUDE (PRIMARY) — REQUIRED (validated at startup)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─────────────────────────────────────────
# AI — OPENAI (EMBEDDINGS + FALLBACK) — OPTIONAL, degrades gracefully
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ─────────────────────────────────────────
# GOOGLE SHEETS SYNC — OPTIONAL, degrades gracefully
# ─────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your-google-sheet-id

# ─────────────────────────────────────────
# APP CONFIG — REQUIRED for OAuth (Facebook/Instagram/Google Business/
# LinkedIn/X) and for correct share/redirect links generally.
# ─────────────────────────────────────────
# ISS-037: this is the ONLY base-URL variable the app reads (used for share links,
# post-logout redirects, and — RC blocker fix — every OAuth redirect_uri). A
# second, undocumented name — NEXT_PUBLIC_SITE_URL — used to be read in one file
# (auth/logout); that file has been updated to use this variable instead, so
# there is now exactly one name to set.
#
# RC blocker fix: the OAuth start/callback routes (src/app/api/social/oauth/
# [platform]/{start,callback}/route.ts) no longer fall back to any hardcoded
# domain if this is unset — they fail with a clear 503 instead. Set this to
# the exact base URL of the environment you're deploying:
#   Local development : http://localhost:3000
#   Production         : https://crm.bookmyspaces.in
#   Vercel Preview     : the deployment's own preview URL (OAuth will not work
#                        on preview deployments unless this is set AND that
#                        exact URL is registered as a valid redirect URI with
#                        each provider — Meta/Google/LinkedIn/X all require an
#                        exact match. Most teams leave OAuth untested on
#                        preview and rely on Local + Production only.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# UNUSED (ISS-038, confirmed no reference in src/ — this project uses Supabase Auth, not next-auth) — NEXTAUTH_SECRET not required

# ─────────────────────────────────────────
# BUSINESS INFO / CONFIG (used in AI prompts, invoices) — OPTIONAL, all default safely
# ─────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_WHATSAPP=9051459463
# Percentage (e.g. 18 for 18%) applied to proposal/invoice totals in
# src/lib/tax.ts. Defaults to 0 (no tax added) if unset — safe for a business
# not yet configured for GST/tax line items.
DEFAULT_TAX_RATE_PERCENT=0

# ─────────────────────────────────────────
# LIVE WHATSAPP INTEGRATION — Meta Cloud API (this is what the code actually
# uses for sending/receiving WhatsApp messages) — OPTIONAL, degrades gracefully
# ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-meta-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
# Must match whatever verify token you configure in the Meta App dashboard's
# webhook subscription (src/app/api/whatsapp/webhook/route.ts).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any-secret-string-you-choose
# App Secret from the Meta App dashboard (Settings → Basic). Required for
# webhook signature verification (X-Hub-Signature-256) — until this is set,
# the webhook logs a warning but still accepts unsigned requests
# (see src/app/api/whatsapp/webhook/route.ts verifySignature()).
WHATSAPP_APP_SECRET=your-meta-app-secret

# ─────────────────────────────────────────
# SOCIAL — Meta Graph API (Facebook Page + Instagram Lead Ads/Messenger/DM
# capture, src/lib/social/adapters/meta-adapter.ts, and the Facebook/Instagram
# OAuth connect flow, src/lib/social/oauth/oauth-config.ts). Found missing
# from this file during Go-Live prep (2026-07-27) despite the adapter code
# depending on all of these — it's credential-gated, not credential-optional:
# isConfigured() returns false and every Graph call short-circuits with a
# clear "not configured" result until these are set, and verifyWebhook()
# rejects (fails closed, 401) rather than accepting unsigned requests, so the
# Social channel is safe to leave unconfigured — it just won't capture or
# publish anything. OPTIONAL, degrades gracefully (startup warning only).
# ─────────────────────────────────────────
# Meta App ID — Settings → Basic in the Meta App dashboard. Used as the OAuth
# client_id for the Facebook/Instagram "Connect" flow (oauth-config.ts).
META_APP_ID=your-meta-app-id
# Meta App Secret — used for BOTH webhook signature verification (above) AND
# as the OAuth client_secret for the Facebook/Instagram connect flow.
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=any-secret-string-you-choose
# Legacy/static publish path — used only when a social_posts row has no
# selected account_id (no OAuth account chosen). Prefer connecting via OAuth
# (Content Studio → Accounts → Connect Facebook/Instagram) instead.
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_PAGE_ID=your-facebook-page-id
META_IG_ID=your-instagram-business-account-id

# ─────────────────────────────────────────
# SOCIAL — LinkedIn OAuth + publishing (src/lib/social/oauth/oauth-config.ts,
# src/lib/social/adapters/linkedin-adapter.ts). OPTIONAL, degrades gracefully.
# ─────────────────────────────────────────
# From the LinkedIn Developer Portal app you register (Products: Share on
# LinkedIn / Community Management API for organization posting).
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Legacy/static publish path — used only when a post has no selected
# account_id. Prefer connecting via OAuth instead.
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
# Always required from env regardless of OAuth — LinkedIn's OAuth identity
# call (/v2/userinfo) returns the connected MEMBER, not the organization/
# Company Page, so the org URN a post is authored as can't be resolved via
# OAuth today (see linkedin-adapter.ts's header comment). Format:
# "urn:li:organization:12345".
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your-org-id

# ─────────────────────────────────────────
# SOCIAL — Google Business Profile OAuth + publishing (oauth-config.ts,
# src/lib/social/adapters/google-business-adapter.ts). OPTIONAL, degrades
# gracefully.
# ─────────────────────────────────────────
# From a Google Cloud project with the Business Profile API (Account
# Management + Business Information) enabled, OAuth consent screen
# configured for the business.manage scope.
GOOGLE_BUSINESS_CLIENT_ID=your-google-oauth-client-id
GOOGLE_BUSINESS_CLIENT_SECRET=your-google-oauth-client-secret
# Legacy/static publish path — used only when a post has no selected
# account_id. Prefer connecting via OAuth (the connect flow auto-discovers
# and stores the correct Location id per account, see oauth-service.ts).
GOOGLE_BUSINESS_ACCESS_TOKEN=your-google-business-access-token
GOOGLE_BUSINESS_LOCATION_ID=accounts/your-account-id/locations/your-location-id

# ─────────────────────────────────────────
# SOCIAL — X (Twitter) OAuth 2.0 + PKCE + publishing (oauth-config.ts,
# src/lib/social/adapters/x-adapter.ts). OPTIONAL, degrades gracefully.
# ─────────────────────────────────────────
# From the X Developer Portal (OAuth 2.0 app, Elevated/Pro access tier
# required for tweet.write in production).
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
# Legacy/static publish path — used only when a post has no selected
# account_id. Prefer connecting via OAuth instead.
X_ACCESS_TOKEN=your-x-access-token
# HMAC key for X's Account Activity API webhook signature verification, if/
# when a webhook subscription is provisioned. Not required for publishing.
X_APP_SECRET=your-x-app-secret

# ─────────────────────────────────────────
# SOCIAL OAUTH — STATE SIGNING (RC blocker fix)
# Required for the "Connect" button to work on ANY OAuth-capable platform
# (Facebook, Instagram, Google Business, LinkedIn, X) — signs the stateless
# `state` param round-tripped through each provider's redirect (src/lib/
# social/oauth/oauth-state.ts). Without this, /api/social/oauth/[platform]/
# start returns a clear 503 'oauth_not_configured' instead of starting the
# flow. OPTIONAL at the app level (only Social OAuth connect is degraded),
# but required for ANY platform's connect flow to function.
#
# Generate with:
#   openssl rand -base64 32
# (any random 32+ character string works — this signs, it isn't decoded).
# ─────────────────────────────────────────
SOCIAL_OAUTH_STATE_SECRET=any-random-32-plus-character-string

# ─────────────────────────────────────────
# SOCIAL OAUTH — TOKEN ENCRYPTION (RC blocker fix)
# Required before connecting ANY platform via OAuth (Facebook, Instagram,
# Google Business, LinkedIn, X — see src/app/api/social/oauth/[platform]/
# callback/route.ts and /api/social/accounts's manual-token path). Every
# access/refresh token is encrypted at rest (AES-256-GCM, src/lib/social/
# token-cipher.ts) before it is ever written to social_accounts — this key
# is what encrypts/decrypts it.
#
# Generate a secure, random 32-byte key (base64-encoded) with:
#   openssl rand -base64 32
#
# Do NOT commit the real value anywhere (this file only ever holds a
# placeholder) — set the real key directly in your deployment platform's
# environment variables (e.g. Vercel Project Settings → Environment
# Variables), never in a checked-in .env file.
#
# If this key is missing or malformed, the app fails gracefully rather than
# storing anything insecurely: isTokenCipherConfigured() returns false, the
# OAuth callback route redirects back with an 'encryption_not_configured'
# error banner instead of connecting the account, and the manual-token
# /api/social/accounts route returns a clear 400 instead of saving a token.
# Nothing is ever stored in plaintext and no token is silently dropped.
# ─────────────────────────────────────────
SOCIAL_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ─────────────────────────────────────────
# LEGACY WHATSAPP INTEGRATION — Wati.io (only used for the /api/health status
# check and the transcription helper in src/lib/transcription.ts; the actual
# send/receive path above, Meta Cloud API, does not use these) — OPTIONAL
# ─────────────────────────────────────────
WATI_BASE_URL=
WATI_API_TOKEN=

# ─────────────────────────────────────────
# OUTBOUND EMAIL — Resend (proposal/invoice/payment-reminder/follow-up/
# booking-confirmation emails; see src/lib/email/). Get a free API key at
# https://resend.com after signing up and verifying a sending domain (or use
# their shared onboarding@resend.dev address for testing, no domain needed).
# Until RESEND_API_KEY is set, the proposal-email button falls back to
# opening a mailto: link instead of failing outright; the other email
# routes (invoice/payment-reminder/booking-confirmation/follow-up) will
# return a clear "not configured yet" message instead of sending.
# OPTIONAL, degrades gracefully.
# ─────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain you've verified in Resend, e.g.
# "BookMySpaces <proposals@bookmyspaces.in>". Defaults to Resend's shared
# testing address if left unset.
EMAIL_FROM=BookMySpaces <onboarding@resend.dev>

# ─────────────────────────────────────────
# CRON AUTHENTICATION — OPTIONAL (fails OPEN — i.e. unauthenticated — if
# unset; set this before relying on cron endpoints in production)
# ─────────────────────────────────────────
# Bearer token compared against incoming Authorization header on every
# src/app/api/cron/*/route.ts endpoint. Set the SAME value here and in your
# scheduler's config (Vercel Cron Jobs' Authorization header, if used).
CRON_SECRET=generate-a-random-secret-and-set-the-same-value-in-vercel-cron-config

# ─────────────────────────────────────────
# DATABASE MIGRATIONS — one-off local/CI scripts only (npm run db:migrate:v3,
# db:rollback:v3, db:smoke-test:v3) — NOT read by the running Next.js app
# itself. Direct Postgres connection string from Supabase (Project Settings →
# Database → Connection string → URI). OPTIONAL — only needed when actually
# running a migration script from your machine.
# ─────────────────────────────────────────
DATABASE_URL=postgres://postgres:[password]@[host]:5432/postgres

# ─────────────────────────────────────────
# REMOVED (ISS-029/ISS-038): the following variables used to be listed here but
# are never read anywhere in the code, so they've been removed to avoid confusion:
# ADMIN_EMAIL, ADMIN_PASSWORD (real login is handled by Supabase Auth instead),
# WATI_VERIFY_TOKEN, WATI_WEBHOOK_SECRET (no matching webhook code path exists),
# NEXT_PUBLIC_BUSINESS_PHONE (not referenced anywhere in src/).
# If you find you need any of these for a feature you're adding, that's fine —
# just document what it's for here when you add it back.
# ─────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
# BOOKMYSPACES AI CRM — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in all values
# NEVER commit .env.local to version control

# ─────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────
# AI — CLAUDE (PRIMARY)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─────────────────────────────────────────
# AI — OPENAI (EMBEDDINGS + FALLBACK)
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ─────────────────────────────────────────
# GOOGLE SHEETS SYNC
# ─────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your-google-sheet-id

# ─────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────
# ISS-037: this is the ONLY base-URL variable the app reads (used for share links
# and post-logout redirects). A second, undocumented name — NEXT_PUBLIC_SITE_URL —
# used to be read in one file (auth/logout); that file has been updated to use
# this variable instead, so there is now exactly one name to set.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# UNUSED (ISS-038, confirmed no reference in src/ — this project uses Supabase Auth, not next-auth) — NEXTAUTH_SECRET not required

# ─────────────────────────────────────────
# BUSINESS INFO (used in AI prompts)
# ─────────────────────────────────────────
NEXT_PUBLIC_BUSINESS_WHATSAPP=9051459463

# ─────────────────────────────────────────
# INVOICING — flat tax rate (src/lib/tax.ts getTaxRatePercent()). Optional:
# unset, unparseable, or outside 0-100 all safely fall back to 0 (no tax —
# today's existing behavior). Not full statutory GST-invoice compliance
# (no CGST/SGST/IGST split, no HSN/SAC, no GSTIN formatting) — see tax.ts
# header before relying on this for real GST filing.
# ─────────────────────────────────────────
DEFAULT_TAX_RATE_PERCENT=0

# ─────────────────────────────────────────
# LIVE WHATSAPP INTEGRATION — Meta Cloud API (this is what the code actually
# uses for sending/receiving WhatsApp messages)
# ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-meta-cloud-api-access-token
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
# Must match whatever verify token you configure in the Meta App dashboard's
# webhook subscription (src/app/api/whatsapp/webhook/route.ts). This is the
# name the app looks for first; WHATSAPP_VERIFY_TOKEN is also accepted as a
# fallback if that's what got set instead, so a naming mismatch during setup
# doesn't block webhook verification — but set THIS name going forward.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any-secret-string-you-choose
# App Secret from the Meta App dashboard (Settings → Basic). Required for
# webhook signature verification (X-Hub-Signature-256) — until this is set,
# the webhook logs a warning but still accepts unsigned requests
# (see src/app/api/whatsapp/webhook/route.ts verifySignature()).
WHATSAPP_APP_SECRET=your-meta-app-secret

# ─────────────────────────────────────────
# SOCIAL — Meta Graph API (Facebook Page + Instagram Lead Ads/Messenger/DM
# capture, src/lib/social/adapters/meta-adapter.ts). Found missing from this
# file during Go-Live prep (2026-07-27) despite the adapter code depending on
# all four — it's credential-gated, not credential-optional: isConfigured()
# returns false and every Graph call short-circuits with a clear "not
# configured" result until these are set, and verifyWebhook() rejects (fails
# closed, 401) rather than accepting unsigned requests, so the Social channel
# is safe to leave unconfigured — it just won't capture anything.
# ─────────────────────────────────────────
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=any-secret-string-you-choose
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_PAGE_ID=your-facebook-page-id
META_IG_ID=your-instagram-business-account-id

# ─────────────────────────────────────────
# GOOGLE BUSINESS PROFILE — OAuth foundation (src/app/api/google/gbp/connect,
# .../callback). Separate Cloud project/OAuth client from the GOOGLE_SERVICE_
# ACCOUNT_EMAIL above (that one's a Sheets service account; this is a real
# OAuth 2.0 web client requesting the business.manage scope). Until these are
# set, /api/google/gbp/connect returns a clear "not configured" 500 instead
# of a broken redirect. Stored tokens are encrypted with the existing
# SOCIAL_TOKEN_ENCRYPTION_KEY below, not these three.
# ─────────────────────────────────────────
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=
GOOGLE_GBP_REDIRECT_URI=

# ─────────────────────────────────────────
# LEGACY WHATSAPP INTEGRATION — Wati.io (only used for the /api/health status
# check; the actual send/receive path above, Meta Cloud API, does not use these)
# ─────────────────────────────────────────
WATI_BASE_URL=
WATI_API_TOKEN=

# ─────────────────────────────────────────
# OUTBOUND EMAIL — Resend (proposal/invoice/payment-reminder/follow-up/
# booking-confirmation emails; see src/lib/email/). Get a free API key at
# https://resend.com after signing up and verifying a sending domain (or use
# their shared onboarding@resend.dev address for testing, no domain needed).
# Until RESEND_API_KEY is set, the proposal-email button falls back to
# opening a mailto: link instead of failing outright; the other email
# routes (invoice/payment-reminder/booking-confirmation/follow-up) will
# return a clear "not configured yet" message instead of sending.
# ─────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain you've verified in Resend, e.g.
# "BookMySpaces <proposals@bookmyspaces.in>". Defaults to Resend's shared
# testing address if left unset.
EMAIL_FROM=BookMySpaces <onboarding@resend.dev>

# ─────────────────────────────────────────
# CRON AUTHENTICATION
# ─────────────────────────────────────────
# Bearer token compared against incoming Authorization header on cron routes
# (src/app/api/cron/followups/route.ts and src/app/api/cron/escalations/route.ts).
CRON_SECRET=generate-a-random-secret-and-set-the-same-value-in-vercel-cron-config

# ─────────────────────────────────────────
# REMOVED (ISS-029/ISS-038): the following variables used to be listed here but
# are never read anywhere in the code, so they've been removed to avoid confusion:
# ADMIN_EMAIL, ADMIN_PASSWORD (real login is handled by Supabase Auth instead),
# WATI_VERIFY_TOKEN, WATI_WEBHOOK_SECRET (no matching webhook code path exists),
# NEXT_PUBLIC_BUSINESS_PHONE (not referenced anywhere in src/).
# If you find you need any of these for a feature you're adding, that's fine —
# just document what it's for here when you add it back.
# ─────────────────────────────────────────

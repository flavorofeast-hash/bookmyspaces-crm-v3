{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ai-summary/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/proposals/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/knowledge/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/analytics/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/followups/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/followups/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/escalations/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/campaign-queue/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/stay-lifecycle/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/review-reminders/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/social-publish/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/marketing-automations/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/drip-sequences/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/ai-followup-assistant/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/social-token-refresh/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path":     "/api/cron/followups",
      "schedule": "0 9 * * *"
    },
    {
      "path":     "/api/cron/escalations",
      "schedule": "0 18 * * *"
    },
    {
      "path":     "/api/cron/stay-lifecycle",
      "schedule": "0 8 * * *"
    },
    {
      "path":     "/api/cron/review-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path":     "/api/cron/social-publish",
      "schedule": "0 9 * * *"
    },
    {
      "path":     "/api/cron/marketing-automations",
      "schedule": "0 7 * * *"
    },
    {
      "path":     "/api/cron/drip-sequences",
      "schedule": "0 11 * * *"
    },
    {
      "path":     "/api/cron/ai-followup-assistant",
      "schedule": "0 6 * * *"
    },
    {
      "path":     "/api/cron/social-token-refresh",
      "schedule": "0 5 * * *"
    },
    {
      "path":     "/api/cron/campaign-queue",
      "schedule": "0 12 * * *"
    }
  ]
}
